# 复制为 .env 后填入自己的值：cp .env.example .env
#
# 生成随机值可以用：
#   openssl rand -hex 24

# ⚠️ 密码只允许字母数字。
#    它会被原样拼进后端的连接串 mysql://root:<密码>@mysql:3306/...
#    含 @ : / ? # 等字符会被 URL 截断，必须自行百分号编码。
MYSQL_ROOT_PASSWORD=CHANGE_ME_ALPHANUMERIC
MYSQL_DATABASE=ai_english_coach

# 宿主侧数据库端口。若本机 3306 已被占用，容器对外改用 3307。
MYSQL_HOST_PORT=3307

# 至少 32 位随机字符串，切勿使用示例值
JWT_SECRET=CHANGE_ME_RANDOM_32_CHARS_MIN
